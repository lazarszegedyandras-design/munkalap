# Munkalap-Eszkoz App v0.31.0 production example.
# Copy to .env.production, chmod 600, then create the secret files with
# deploy/vps/bootstrap-production-config.sh.
APP_VERSION=0.31.0
ENVIRONMENT=production

# Public endpoint. APP_DOMAIN must contain only the DNS name, without scheme.
APP_DOMAIN=app.example.hu
TLS_EMAIL=admin@example.hu
PUBLIC_BASE_URL=https://app.example.hu
CORS_ORIGINS=https://app.example.hu

# Host firewall/SSH gate. Restrict this to the administrator's fixed public IP/CIDR.
ADMIN_SSH_CIDR=REPLACE_WITH_ADMIN_CIDR
SSH_PORT=22

# Step 2 scanner image. Update only through a reviewed release change.
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969

POSTGRES_DB=workapp
POSTGRES_USER=workapp
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL=
DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_MIGRATION_URL_FILE=/run/secrets/database_migration_url

SECRET_KEY=
SECRET_KEY_FILE=/run/secrets/secret_key
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_FILE=/run/secrets/mfa_encryption_key
BACKUP_AGENT_TOKEN=
BACKUP_AGENT_TOKEN_FILE=/run/secrets/backup_agent_token
BACKUP_RUNNER_TOKEN_FILE=/run/secrets/backup_runner_token
BOOTSTRAP_ADMIN_EMAIL=admin@example.hu
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
SECRETS_DIR=./secrets

SESSION_COOKIE_SECURE=true
PASSWORD_MIN_LENGTH=12
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
SESSION_TOUCH_INTERVAL_SECONDS=60
ADMIN_MFA_REQUIRED=true
MFA_CHALLENGE_EXPIRE_MINUTES=5
SENSITIVE_MFA_MAX_AGE_SECONDS=300
MFA_STEP_UP_RATE_LIMIT_ATTEMPTS=5
MFA_STEP_UP_RATE_LIMIT_WINDOW_SECONDS=300
MFA_STEP_UP_RATE_LIMIT_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_IP_RATE_LIMIT_ATTEMPTS=50
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
DOCS_ENABLED=false

# Fixed production application network. Change this before the first deploy if
# it overlaps a route already used by the VPS or another Docker network.
APP_NETWORK_SUBNET=172.30.250.0/24
EDGE_INTERNAL_IP=172.30.250.10
FRONTEND_INTERNAL_IP=172.30.250.20
BACKEND_INTERNAL_IP=172.30.250.30
TRUSTED_PROXY_CIDRS=172.30.250.20/32

MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_HOST=clamav
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=15
MALWARE_SCAN_FAIL_CLOSED=true

RUNTIME_DIR=/app/runtime
ARCHIVE_DIR=/app/runtime/work_order_archives
ARCHIVE_MAX_SIZE_MB=25
PROCUREMENT_MAX_SIZE_MB=25
IMPORT_MAX_SIZE_MB=50

# Mobile technician API and signed work-order evidence.
MOBILE_ACCESS_TOKEN_EXPIRE_MINUTES=15
MOBILE_REFRESH_TOKEN_EXPIRE_DAYS=30
MOBILE_SIGNATURE_MAX_SIZE_KB=1024
MOBILE_SIGNATURE_DIR=/app/runtime/work_order_signatures
MOBILE_PHOTO_DIR=/app/runtime/work_order_photos
MOBILE_PHOTO_MAX_SIZE_MB=8
MOBILE_PHOTO_MAX_PIXELS=12000000
MOBILE_PHOTO_MAX_DIMENSION=2048
BUSINESS_TIMEZONE=Europe/Budapest
WORK_ORDER_ACCEPTANCE_TEXT_VERSION=1
WORK_ORDER_ACCEPTANCE_TEXT=A munkalapon feltuntetett munkavegzest es adatokat megismertem es elfogadom.

# Android push notifications. The service-account JSON is mounted as a Docker secret.
PUSH_NOTIFICATIONS_ENABLED=true
FCM_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase_service_account
PUSH_WORKER_POLL_SECONDS=5
PUSH_WORKER_LOCK_TIMEOUT_SECONDS=300
PUSH_RETRY_MAX_ATTEMPTS=5
PUSH_ANDROID_CHANNEL_ID=work_orders
# Opcionális: production acceptance során tényleges FCM smoke test erre a regisztrált eszközre.
# PUSH_SMOKE_DEVICE_ID=123
PUSH_SMOKE_WAIT_SECONDS=45
BACKEND_WORKERS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
BACKUP_TIMEZONE=Europe/Budapest

# Mandatory offsite encrypted backup for public production.
OFFSITE_BACKUP_ENABLED=true
# Example for an S3-compatible object store:
# RESTIC_REPOSITORY=s3:https://s3.example-provider.hu/bucket-name/munkalap
RESTIC_REPOSITORY=REPLACE_WITH_S3_REPOSITORY
AWS_DEFAULT_REGION=eu-central-1
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12

# Optional internal monitoring UI. Bound to 127.0.0.1 only and intended to be
# opened through an SSH tunnel. External uptime monitoring is still required.
ENABLE_LOCAL_MONITORING=false
UPTIME_KUMA_PORT=3001
