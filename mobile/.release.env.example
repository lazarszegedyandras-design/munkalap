# Nem titkos release-elvárások. Ezt a fájlt a buildgép saját környezetében
# tarthatod, vagy a változókat CI secret/variable storage-ból adhatod át.
MUNKALAP_FIREBASE_PROJECT_ID=your-firebase-project-id
# A release upload certificate SHA-256 fingerprintje, kettőspontokkal.
MUNKALAP_EXPECTED_SIGNING_CERT_SHA256=AA:BB:CC:DD:EE:FF
# Opcionális helyi bundletool JAR az AAB mélyebb validációjához.
BUNDLETOOL_JAR=/opt/android-tools/bundletool.jar
